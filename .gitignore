__pycache__/
*.pyc

# Packaging / build artifacts
*.egg-info/
build/
dist/
.venv/
venv/

# Tool caches
.ruff_cache/
.pytest_cache/

# Local agent/editor state, not project configuration. If shared project
# config ever belongs in here, negate the specific file (e.g.
# `!.claude/settings.json`) rather than dropping this rule.
.claude/

# Machine-local agent context: paths to the private notes tree, hardware
# quirks, "this repo is public" reminders. CLAUDE.md (committed) carries the
# parts that are useful to anyone working on this repo.
CLAUDE.local.md

# makepkg build artifacts (packaging/)
src/
pkg/
*.pkg.tar.zst
*.tar.gz

# makepkg's own local bare mirror clone for packaging/git/PKGBUILD's
# git+https source -- its .git internals, not a source checkout. Got swept
# into a commit once by an over-broad `git add`; anchored so it can't be
# confused with the real g7ctl/ package directory at the repo root.
/packaging/git/g7ctl/

# Local packaging test tool (see its header) -- deliberately untracked.
/test-build.sh
packaging/.testbuild/
