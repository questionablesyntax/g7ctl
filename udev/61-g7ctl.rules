# Grants rw access to the controller's runtime XInput identity, its
# vendor/config identity, and the wireless dongle's identity, so the GUI/
# tray app (and CLI) can run as a normal user instead of root.
#
# Uses systemd-logind's uaccess mechanism (TAG+="uaccess") rather than a
# dedicated group -- access is granted automatically to whoever's logged in
# at the physical seat, no group/usermod/re-login setup step needed. This
# is the same mechanism stock rules already use for USB mice, cameras, and
# scanners (see /usr/lib/udev/rules.d/70-uaccess.rules on most distros).
#
# Install: see README.md "Running without root" for setup steps.
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="100a", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="109b", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="109c", TAG+="uaccess"

# Vendor/config identity on at least one other G7 Pro variant -- see
# PID_VENDOR_TRIMODE in pyg7/constants.py and PROTOCOL.md "Device
# identities". Without this line, a user on that hardware who follows
# this file's own setup instructions still needs root: the Python side
# recognizes the PID, but raw USB access to it is denied without this
# rule too. Confirmed 2026-08-19 by a user who found that the hard way
# (added it by hand before this line existed) -- not a guess.
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="1003", TAG+="uaccess"

# Vendor/config identity on a G7 Pro "Zenless Zone Zero" edition -- see
# PID_VENDOR_ZZZ in pyg7/constants.py. Same reasoning as the 1003 line
# above. Confirmed 2026-08-19: the reporter tested this rule with the
# fix branch and read real config back over it, end to end.
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="105d", TAG+="uaccess"

# The controller's on-device "default GameSir identity" -- reached via the
# Menu+Share button combo (documented in GameSir's manual as an XInput/
# native-identity toggle), distinct from both 100a and the 109b vendor/
# config mode. Found 2026-07-30. It runs a different protocol that has not
# been reverse-engineered (see PROTOCOL.md "Device identities"), so nothing
# here talks to it -- access is granted only so the tool can detect this
# identity and tell the user to switch back, instead of reporting a
# generic "no device found".
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="1022", TAG+="uaccess"
