# Maintainer: J Whittington (onemyndseye, questionablesyntax)
#
# Split package: one source tree, three installable packages, matching the
# repo's own pyg7 (library, Apache-2.0) / g7ctl (CLI) / g7ctlc (GUI, "G7
# Control Center") layout -- both apps GPL-3.0-or-later, depending on the
# library rather than the other way round. See ../README.md "License".
#
# One caveat this whole PKGBUILD works around: pyproject.toml still builds
# all three as ONE wheel -- the independently-versioned packages/ split
# hasn't happened yet. Each package_*() below installs that one wheel into
# its own pkgdir and prunes the two-thirds that don't belong there, rather
# than pretending three separate wheels exist. Revisit this if that split
# ever lands -- three real per-project builds would replace the
# install+prune dance entirely. A known consequence in the meantime: each
# package's Python dist-info metadata still lists the files that got
# pruned. Harmless for pacman's purposes, but technically inaccurate.
#
# Build-tested 2026-07-31 against a real release tarball: `makepkg`
# produced all three packages cleanly, and `pacman -U` installed them. Verified in the resulting
# .pkg.tar.zst files: each package contains only its own Python package and
# only its own /usr/bin entry (nothing leaks across the prune), python-pyg7
# ships the udev rule to /usr/lib/udev/rules.d/, g7ctlc ships the generated
# .desktop plus the hicolor icon, all three carry the right LICENSE, and the
# inter-package depends are correct. `makepkg --verifysource` passes against
# the sha256sum below.
#
# A first `makepkg -si` attempt failed: all three packages shipped the
# wheel's single .dist-info directory, so pacman refused the transaction
# with "exists in both" on every file in it. Fixed by giving python-pyg7
# sole ownership of it (see that function). Re-verified by diffing the three
# packages' file lists -- zero overlap, which is exactly what pacman checks
# -- then extracting all three into one root and confirming the merged
# layout imports cleanly, resolves importlib.metadata.version("g7ctl"),
# keeps both entry points, and runs /usr/bin/g7ctl.
#
# Confirmed working end to end on 2026-07-31: all three packages installed
# via `makepkg -i`, and `g7ctl` resolves on PATH at /usr/bin/g7ctl.
#
# Re-verified 2026-08-01 for v0.1.2 and again for v0.1.3: `makepkg
# --verifysource` passes against the sha256sum below, `makepkg` builds all
# three packages from the release tarball, each .PKGINFO carries the right
# version, and the .dist-info is still owned by python-pyg7 alone (the 0.1.1
# "exists in both" failure has not returned). For 0.1.3 specifically, the
# desktop entry extracted from the built package is the one derived from
# packaging/g7ctlc.desktop -- Settings;HardwareSettings; with Keywords -- and
# passes desktop-file-validate, which is the change this release exists for.
# Not re-installed with pacman for either -- the 0.1.1 install test above is
# the last one that covered that step.

pkgbase=g7ctl
pkgname=('python-pyg7' 'g7ctl' 'g7ctlc')
pkgver=0.1.5
pkgrel=1
pkgdesc="Configure a GameSir G7 Pro controller on Linux, without Windows or the Nexus app"
arch=('any')
url="https://github.com/questionablesyntax/g7ctl"
license=('Apache-2.0' 'GPL-3.0-or-later')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')

# Points at the v$pkgver release tag. Re-run `updpkgsums` on every version
# bump -- the checksum below is specific to one tarball, and a stale one
# fails validation rather than silently building the wrong source.
source=("$pkgbase-$pkgver.tar.gz::https://github.com/questionablesyntax/g7ctl/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('df5620c51cea1f787d3782c19b2393edca64103e5d50236f7fe5341a83a86170')

build() {
  cd "$pkgbase-$pkgver"
  python -m build --wheel --no-isolation
}

package_python-pyg7() {
  pkgdesc="Reverse-engineered protocol library for the GameSir G7 Pro controller"
  depends=('python' 'python-pyusb')
  license=('Apache-2.0')

  cd "$pkgbase-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  # Keep only pyg7/ -- the wheel bundles g7ctl/g7ctlc too (see header note).
  find "$pkgdir" -depth \( -name g7ctl -o -name g7ctlc \) -type d -exec rm -rf {} +
  rm -f "$pkgdir/usr/bin/g7ctl" "$pkgdir/usr/bin/g7ctlc"

  # This package, and only this one, ships the wheel's .dist-info. One wheel
  # is one Python *distribution*, so there is exactly one metadata directory
  # and it cannot be split three ways -- if every package installed it,
  # pacman would refuse the transaction with "exists in both" on every file
  # inside it. python-pyg7 is the right owner because both other packages
  # depend on it, so the metadata is always installed exactly once and is
  # never missing. Its RECORD still lists the pruned files; see the header.

  # Ships the udev rule so `pacman -S python-pyg7` alone is enough for raw
  # USB access to work with no manual setup step -- uaccess (see the rule
  # itself) grants it automatically to whoever's logged in at the seat, no
  # group/usermod/re-login needed, unlike the group-based rule this
  # replaced. Package-shipped rules belong in /usr/lib/udev/rules.d/, not
  # /etc/udev/rules.d/ (that path is for local user overrides only).
  install -Dm644 "$srcdir/$pkgbase-$pkgver/udev/61-g7ctl.rules" \
    "$pkgdir/usr/lib/udev/rules.d/61-g7ctl.rules"

  install -Dm644 pyg7/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_g7ctl() {
  pkgdesc="CLI to configure a GameSir G7 Pro controller on Linux"
  depends=("python-pyg7=$pkgver-$pkgrel")
  license=('GPL-3.0-or-later')

  cd "$pkgbase-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  find "$pkgdir" -depth \( -name pyg7 -o -name g7ctlc \) -type d -exec rm -rf {} +
  rm -f "$pkgdir/usr/bin/g7ctlc"
  # Owned by python-pyg7 (a dependency), which ships it once -- see there.
  rm -rf "$pkgdir"/usr/lib/python*/site-packages/"$pkgbase"-"$pkgver".dist-info

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_g7ctlc() {
  pkgdesc="G7 Control Center -- PyQt6 GUI + tray app for the GameSir G7 Pro"
  depends=("python-pyg7=$pkgver-$pkgrel" 'python-pyqt6')
  optdepends=('libappindicator-gtk3: tray icon support in some DEs/WMs')
  license=('GPL-3.0-or-later')

  cd "$pkgbase-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  find "$pkgdir" -depth \( -name pyg7 -o -name g7ctl \) -type d -exec rm -rf {} +
  rm -f "$pkgdir/usr/bin/g7ctl"
  # Owned by python-pyg7 (a dependency), which ships it once -- see there.
  rm -rf "$pkgdir"/usr/lib/python*/site-packages/"$pkgbase"-"$pkgver".dist-info

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 g7ctlc/assets/icon_black.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/g7ctlc.png"

  # Derived from packaging/g7ctlc.desktop rather than written out again here.
  # That file's Exec=/Path=/Icon= hardcode an absolute checkout path on
  # purpose (see README.md "GUI"), which is exactly wrong for an installed
  # package -- so those three lines, and only those, are rewritten: Exec
  # relies on the g7ctlc console entry point being on PATH, Icon on the
  # hicolor install just above, and Path= is meaningless once installed.
  # Everything else (Name, Comment, Categories, Keywords, StartupWMClass)
  # comes through unchanged, so there is one place to edit it.
  sed -e 's|^Exec=.*|Exec=g7ctlc|' \
      -e 's|^Icon=.*|Icon=g7ctlc|' \
      -e '/^Path=/d' \
      -e '/^#/d' \
      packaging/g7ctlc.desktop \
      > "$srcdir/g7ctlc.desktop"
  install -Dm644 "$srcdir/g7ctlc.desktop" \
    "$pkgdir/usr/share/applications/g7ctlc.desktop"
}
